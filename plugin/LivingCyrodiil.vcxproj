    <ClInclude Include="src\awareness.h" />
    <ClInclude Include="src\quests.h" />
    <ResourceCompile Include="src\LivingCyrodiil.rc" />
    <ClInclude Include="src\key_names.h" />
    <ClInclude Include="src\vanilla_dialog.h" />
    <None Include="LivingCyrodiil.ini" />
