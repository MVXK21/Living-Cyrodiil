    <ClCompile Include="$(XOBSE)obse\obse\Utilities.cpp" />
    <ClCompile Include="$(XOBSE)obse\obse_common\SafeWrite.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
